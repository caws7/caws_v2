@model IList<CamSistemDataLayer.Models.OptimizasyonHesap>
@using System.Collections.Generic;
@using System.Linq;

@functions {
    string BuildProfilOlcuPozKey(int profilId, string kesimOlcusu)
    {
        if (string.IsNullOrWhiteSpace(kesimOlcusu)) return profilId + "#";
        int parsed;
        return int.TryParse(kesimOlcusu.Trim(), out parsed)
            ? (profilId + "#" + parsed)
            : (profilId + "#" + kesimOlcusu.Trim());
    }

    List<Tuple<string, string>> ResolveKesimPozlari(string olcular, int? profilId, Dictionary<string, Queue<string>> pozOlcuQueueMap, Dictionary<int, string> profilDefaultPozMap, string fallbackPozLabel = "POZ1")
    {
        var result = new List<Tuple<string, string>>();
        if (string.IsNullOrEmpty(olcular)) return result;

        var cuts = olcular.Split(',').Select(s => s.Trim()).Where(s => !string.IsNullOrEmpty(s)).ToList();
        var defaultPoz = fallbackPozLabel;
        if (profilId.HasValue && profilDefaultPozMap.ContainsKey(profilId.Value))
        {
            defaultPoz = profilDefaultPozMap[profilId.Value];
        }

        foreach (var cut in cuts)
        {
            var pozLabel = defaultPoz;
            if (profilId.HasValue)
            {
                var key = BuildProfilOlcuPozKey(profilId.Value, cut);
                Queue<string> queue;
                if (pozOlcuQueueMap.TryGetValue(key, out queue) && queue.Count > 0)
                {
                    pozLabel = queue.Dequeue();
                }
            }
            result.Add(Tuple.Create(cut, pozLabel));
        }

        return result;
    }

    string FormatKesimOlculerByPoz(List<Tuple<string, string>> kesimPozList)
    {
        if (kesimPozList == null || !kesimPozList.Any()) return "";
        var grouped = kesimPozList
            .GroupBy(x => x.Item2 + "|" + x.Item1)
            .Select(g => "<span style='color:green;font-weight:bold;'>[" + g.First().Item2 + "]</span>" + g.Count() + "x" + g.First().Item1);
        return string.Join(", ", grouped);
    }

    string FormatKesimPlaniByPoz(List<Tuple<string, string>> kesimPozList)
    {
        if (kesimPozList == null || !kesimPozList.Any()) return "";
        var sb = new System.Text.StringBuilder();
        sb.Append("<span style='color:red;font-weight:bold;'>(4)</span>");
        foreach (var cut in kesimPozList)
        {
            var pozHtml = "<span style='color:green;font-weight:bold;'>[" + cut.Item2 + "]</span>";
            sb.Append("," + pozHtml + cut.Item1 + ",<span style='color:red;font-weight:bold;'>(4)</span>");
        }
        return sb.ToString();
    }

    string BuildProfilIconUrl(CamSistemDataLayer.Models.Profil profil)
    {
        if (profil == null || string.IsNullOrWhiteSpace(profil.ProfilFoto)) return null;
        try
        {
            var foto = profil.ProfilFoto.Trim().TrimStart('~', '/');
            return Url.Content("~/images/profilicons/" + foto);
        }
        catch (System.Exception ex)
        {
            System.Diagnostics.Debug.WriteLine("[_optimizasyonHesapGrid] Profil icon url hatası: " + ex.Message);
            return null;
        }
    }
}

@if (Model == null || Model.Count == 0)
{
    <div class="alert alert-warning">Optimizasyon kaydı bulunamadı.</div>
    if (!string.IsNullOrWhiteSpace(ViewBag.OptimizasyonEmptyReason as string))
    {
        <div class="alert alert-info" style="margin-top:10px;">
            @ViewBag.OptimizasyonEmptyReason
        </div>
    }
}
else
{
    <table class="table table-bordered" style="margin-top:10px;">
    @{
        var first = Model[0];
        var minimumFireVal = Convert.ToInt32(ViewBag.minimumFire ?? 0);
        var pozOlcuQueueMap = new Dictionary<string, Queue<string>>();
        var rawPozOlcuQueueMap = ViewBag.PozOlcuQueueMap as IDictionary<string, List<string>>;
        if (rawPozOlcuQueueMap != null)
        {
            foreach (var kvp in rawPozOlcuQueueMap)
            {
                pozOlcuQueueMap[kvp.Key] = new Queue<string>(kvp.Value ?? new List<string>());
            }
        }
        var profilDefaultPozMap = new Dictionary<int, string>();
        var rawProfilDefaultPozMap = ViewBag.ProfilDefaultPozMap as IDictionary<int, string>;
        if (rawProfilDefaultPozMap != null)
        {
            foreach (var kvp in rawProfilDefaultPozMap)
            {
                profilDefaultPozMap[kvp.Key] = kvp.Value;
            }
        }
    }
        <thead>
            <tr>
                <th style="text-align:center;vertical-align:middle;width:60px;">Profil Kodu</th>
                <th style="text-align:center;vertical-align:middle;">Profil Kesit</th>
                <th style="text-align:center;vertical-align:middle;">Profil Adı</th>
                <th style="text-align:center;vertical-align:middle;">Birim Ağırlık (gr)</th>
                <th style="text-align:center;vertical-align:middle;">Kesilecek Profil Boy (mm)</th>
                <th style="text-align:center;vertical-align:middle;">Kesim Planı</th>
                <th style="text-align:center;vertical-align:middle;">Kesim Ölçüleri (mm)</th>
                <th style="text-align:center;vertical-align:middle;width:60px;">Fire / Atık</th>
            </tr>
        </thead>

        <tfoot>
            <tr>
                <th colspan="2">Toplam Atık</th>
                <th colspan="2">Fire Stoğa Eklenen Toplam</th>
                <th colspan="2">Asıl Stoktan Kullanılan Toplam</th>
                <th colspan="2">Fire Stoktan Kullanılan Toplam</th>
            </tr>
            <tr>
                <th>Uzunluk (Metre)</th>
                <th>Ağırlık (Kg)</th>
                <th>Uzunluk (Metre)</th>
                <th>Ağırlık (Kg)</th>
                <th>Uzunluk (Metre)</th>
                <th>Ağırlık (Kg)</th>
                <th>Uzunluk (Metre)</th>
                <th>Ağırlık (Kg)</th>
            </tr>
            <tr>
                <th>@string.Format("{0:N2}", first.ToplamAtikUzunluk)</th>
                <th>@string.Format("{0:N2}", first.ToplamAtikAgirlik)</th>
                <th>@string.Format("{0:N2}", first.FireyeEklenenToplamUzunluk)</th>
                <th>@string.Format("{0:N2}", first.FireyeEklenenToplamAgirlik)</th>
                <th>@string.Format("{0:N2}", first.AsilStoktanKullanilanToplamUzunluk)</th>
                <th>@string.Format("{0:N2}", first.AsilStoktanKullanilanToplamAgirlik)</th>
                <th>@string.Format("{0:N2}", first.FiredenKullanilanToplamUzunluk)</th>
                <th>@string.Format("{0:N2}", first.FiredenKullanilanToplamAgirlik)</th>
            </tr>
        </tfoot>

        <tbody>
            @foreach (var r in Model)
            {
                var fireColor = (r.FireAtik ?? 0) > minimumFireVal ? "bg-light-green" : "bg-red";
                var kesimPozList = ResolveKesimPozlari(r.KesilecekOlculer, r.ProfilId, pozOlcuQueueMap, profilDefaultPozMap);
                var profil = r.profil;
                var profilIconUrl = BuildProfilIconUrl(profil);
                <tr>
                    <td style="text-align:center;vertical-align:middle;">
                        @(profil != null ? profil.ProfilKodu : r.ProfilId.ToString())
                    </td>
                    <td style="text-align:center;vertical-align:middle;">
                        @if (!string.IsNullOrEmpty(profilIconUrl))
                        {
                            @Html.Raw("<img class='img-responsive img-thumbnailProf' src='" + profilIconUrl + "' />")
                        }
                    </td>
                    <td style="vertical-align:middle;">
                        @(profil != null ? profil.ProfilAdi : "")
                    </td>
                    <td style="text-align:center;vertical-align:middle;">
                        @(profil != null && profil.BirimAgirlik != null ? profil.BirimAgirlik.Value.ToString() : "")
                    </td>
                    <td style="text-align:center;vertical-align:middle;">@(r.KesimAdet + "x" + r.ProfilBoy)</td>
                    <td style="word-wrap:break-word;min-width:160px;max-width:220px;vertical-align:middle;">
                        @Html.Raw(FormatKesimPlaniByPoz(kesimPozList))
                    </td>
                    <td style="word-wrap:break-word;min-width:140px;max-width:180px;vertical-align:middle;">
                        @Html.Raw(FormatKesimOlculerByPoz(kesimPozList))
                    </td>
                    <td class="@fireColor" style="text-align:center;vertical-align:middle;">@r.FireAtik</td>
                </tr>
            }
        </tbody>
    </table>
}
