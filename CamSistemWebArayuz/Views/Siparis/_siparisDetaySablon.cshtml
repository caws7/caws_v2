                                        <th>CAM KOMBİNASYON</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td>@Html.DisplayFor(modelItem => item.siparisCam.CamKombinasyon)</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                        <button type="button" onclick="PrintElem('camyazdir_@item.Id')" class="btn bg-red waves-effect waves-light pull-right">
                            <i class="material-icons">print</i>
                            <span>YAZDIR</span>
                        </button>
                    </div>
                }
            </div>
        </div>
    </div>
    <div role="tabpanel" class="tab-pane fade" id="maliyet">
        <div class="modal-body">
            <!-- Nav tabs -->
            <ul class="nav nav-tabs tab-nav-right tab-col-amber" role="tablist">
                @{ int pozMaliyetNo = 0; }
                @foreach (var item in Model)
                {
                    pozMaliyetNo++;
                    <li role="presentation">
                        <a href="#@item.Id-maliyet" data-toggle="tab">
                            POZ@(pozMaliyetNo)- @(item.GirilenEn)x@(item.GirilenBoy)/@(item.GirilenAdet) Adet
                        </a>
                    </li>
                }
            </ul>
            <!-- Tab panes -->
            <div class="tab-content">
                @foreach (var item in Model)
                {
                    <div role="tabpanel" class="tab-pane fade" id="@item.Id-maliyet">

                        <div class="alert alert-danger" style="display: none; " id="@item.Id-message-visible">
                            <strong>Bilgilerde değişiklik yapıldı.</strong> Değişikliğin toplam bilgilerine yansıması için sayfayı kapatıp tekrar açınız!
                        </div>

                        <div id="maliyetyazdir_@item.Id" class="dtcustom-@item.Id">
                            <table class="table table-bordered customeditabletable dtcustom-@item.Id maliyet-table">
                                <thead>
                                    <tr>
                                        <th colspan=2><img src="@Url.Content("~/images/logo.png")" style="max-width:100%;max-height:60px;object-fit:contain;display:block;margin:auto;" /></th>
                                        <th colspan=4><center><h2><b>MALİYET</b></h2></center></th>
                                        <th colspan=2 style="word-wrap: break-word;max-width: 250px;">@Html.Raw(item.SistemTamamiRow)</th>
                                    </tr>
                                    <tr>
                                        <th colspan=4>@Html.DisplayFor(model => item.siparisModel.MusteriTamAdi)</th>
                                        <th>Adres</th>
                                        <th colspan="3">@Html.DisplayFor(model => item.siparisModel.MusteriAdres)</th>
                                    </tr>
                                    <tr>
                                        <th>Sipariş Numarası</th>
                                        <th>@Html.DisplayFor(model => item.siparisModel.Id)</th>
                                        <th>Sipariş Tarihi</th>
                                        <th colspan="2">@Html.Raw(string.Format("{0:dd/MM/yyyy}", item.siparisModel.KayitTarihi))</th>
                                        <th>Teslim Tarihi</th>
                                        <th colspan="2">@Html.Raw(string.Format("{0:dd/MM/yyyy}", item.siparisModel.TahminiTeslim))</th>
                                    </tr>
                                    <tr>
                                        <th>
                                            @if (item.GirilenSolEn > 0)
                                            {
                                                @Html.Raw("Sistem Sağ Genişlik")
                                            }
                                            else
                                            {
                                                @Html.Raw("Sistem Genişlik")
                                            }
                                        </th>
                                        <th>
                                            @if (item.GirilenSolEn > 0)
                                            {
                                                @Html.Raw("Sistem Sol Genişlik")
                                            }
                                        </th>
                                        <th>Sistem Yükseklik</th>
                                        <th>Sistem Adet</th>
                                        <th colspan=3>Sistem Renk</th>
                                        <th>Sistem m2</th>
                                    </tr>
                                    <tr>
                                        <th>@Html.DisplayFor(model => item.GirilenEn)</th>
                                        <th>
                                            @if (item.GirilenSolEn > 0)
                                            {
                                                @Html.DisplayFor(model => item.GirilenSolEn)
                                            }
                                        </th>
                                        <th>@Html.DisplayFor(model => item.GirilenBoy)</th>
                                        <th>@Html.DisplayFor(model => item.GirilenAdet)</th>
                                        <th colspan=3>@Html.DisplayFor(model => item.siparisModel.RenkAdi)</th>
                                        @{
                                            var girilenEn = Convert.ToDouble(item.GirilenEn);
                                            var girilenSolEn = Convert.ToDouble(item.GirilenSolEn);
                                            var girilenBoy = Convert.ToDouble(item.GirilenBoy);
                                            var sistemM2 = Convert.ToDouble((girilenEn + girilenSolEn) * girilenBoy / 1000000);
                                        }
                                        <th>@string.Format("{0:N2}", sistemM2)</th>
                                    </tr>
                                    <tr>
                                        <th>No</th>
                                        <th>Sipariş Detay No</th>
                                        <th>MALZEME</th>
                                        <th>BİRİM</th>
                                        <th>MİKTAR</th>
                                        <th>BİRİM FİYAT</th>
                                        <th>TOPLAM TUTAR</th>
                                        <th>#</th>
                                    </tr>
                                </thead>
                                <tfoot>
                                    @{
                                        decimal? toplamMaliyet = null;
                                        decimal? m2 = null;
                                        decimal? teklif = null;

                                        if (item.teklifToplamDetay != null)
                                        {
                                            toplamMaliyet = item.teklifToplamDetay.ToplamMaliyet;
                                            m2 = item.teklifToplamDetay.m2;
                                            teklif = item.teklifToplamDetay.Teklif;
                                        }
                                    }
                                    <tr>
                                        <th colspan="7" class="text-right">TOPLAM MALİYET</th>
                                        <th data-role="toplamMaliyet">@Html.Raw(string.Format("{0:c2}", toplamMaliyet.GetValueOrDefault(0)))</th>
                                    <tr>
                                        <th colspan="7" class="text-right">M2</th>
                                        <th data-role="m2">@Html.Raw(string.Format("{0:c2}", m2.GetValueOrDefault(0)))</th>
                                    <tr>
                                        <th colspan="7" class="text-right">TEKLİF</th>
                                        <th data-role="teklif">@Html.Raw(string.Format("{0:c2}", teklif.GetValueOrDefault(0)))</th>
                                </tfoot>
                                <tbody>
                                    @if (item.teklifList != null)
                                    {
                                        foreach (var item2 in item.teklifList)
                                        {
                                            <tr>
                                                <td class="TeklifId">
                                                    <span>@Html.DisplayFor(modelItem => item2.Id)</span>
                                                </td>
                                                <td class="SiparisEnBoyAdetId">
                                                    <span>@Html.DisplayFor(modelItem => item2.SiparisEnBoyAdetId)</span>
                                                </td>
                                                <td class="Malzeme">
                                                    <span>@Html.DisplayFor(modelItem => item2.Malzeme)</span>
                                                    @*<input type="text" value="@item2.Malzeme" style="display:none" />*@
                                                </td>
                                                <td class="Birim">
                                                    <span>@Html.DisplayFor(modelItem => item2.Birim)</span>
                                                    <input type="text" value="@item2.Birim" style="display:none" />
                                                </td>
                                                <td class="Miktar">
                                                    <span>@Html.DisplayFor(modelItem => item2.Miktar)</span>
                                                    <input type="text" value="@item2.Miktar" style="display:none" />
                                                </td>
                                                <td class="BirimFiyat">
                                                    <span>@Html.Raw(string.Format("{0:c2}", item2.BirimFiyat))</span>
                                                    <input type="text" value="@item2.BirimFiyat" style="display:none" />
                                                </td>
                                                <td class="ToplamTutar">
                                                    <span>@Html.Raw(string.Format("{0:c2}", item2.ToplamTutar))</span>
                                                    <input type="text" value="@item2.ToplamTutar" style="display:none" />
                                                </td>
                                                <td>
                                                    @if (!ViewBag.raporMu)
                                                    {
                                                        <a class="Edit" href="javascript:;">Düzenle</a>
                                                        <a class="Update" href="javascript:;" style="display:none">Güncelle</a>
                                                        <a class="Cancel" href="javascript:;" style="display:none">Vazgeç</a>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>

                        <button type="button" onclick="PrintElem('maliyetyazdir_@item.Id')" class="btn bg-red waves-effect waves-light pull-right">
                            <i class="material-icons">print</i>
                            <span>YAZDIR</span>
                        </button>
                    </div>
                }
            </div>
        </div>
    </div>
    <div role="tabpanel" class="tab-pane fade" id="optimizasyon">
        <div class="modal-body">
            @* Model.First() patlamasın *@
            @{
                var first = Model != null ? Model.FirstOrDefault() : null;
                var optiList = (first != null) ? first.optimizasyonList : null;
                bool optiDataVar = (optiList != null && optiList.Count > 0);
                var optiSiparisId = first != null && first.siparisModel != null ? first.siparisModel.Id.ToString() : "";
            }

            @if (!optiDataVar)
            {
                <text>
                <div id="optimizasyonContent">
                    <div style="text-align:center;padding:30px;color:#666;">
                        <i class="material-icons" style="font-size:48px;vertical-align:middle;">sync</i><br />
                        <span>Optimizasyon yükleniyor...</span>
                    </div>
                </div>

                @if (!(ViewBag.raporMu ?? false))
                {
                    <button type="button"
                            class="btn bg-blue waves-effect"
                            style="margin-top:10px;"
                            onclick="OptimizasyonHesapla('@optiSiparisId')">
                        OPTİMİZASYON YENİDEN HESAPLA
                    </button>
                }

                <script>
                    $(document).ready(function () {
                        $('a[href="#optimizasyon"]').one('shown.bs.tab', function () {
                            OptimizasyonHesapla('@optiSiparisId');
                        });
                    });
                </script>
                </text>
            }
            else
            {
        <div class="tab-content">
            <div id="optimizasyonyazdir">
                @* SENİN MEVCUT OPTİMİZASYON TABLOSU BURADA AYNI KALABİLİR *@
                <table class="table table-bordered">

                    <thead>
                        <tr>
                            <th colspan=2 style="text-align:center;vertical-align:middle;padding:4px;"><img src="@Url.Content("~/images/logo.png")" style="max-width:100%;max-height:80px;object-fit:contain;display:block;margin:auto;" /></th>
                            <th colspan=5><center><h2><b>OPTİMİZASYON</b></h2></center></th>
                            <th colspan=2 style="word-wrap: break-word;max-width: 250px;"></th>
                        </tr>
                        <tr>
                            <th>İmalat Ölçüleri</th>
                            <th colspan="4">@string.Join(" | ", Model.Select((m, i) => "POZ" + (i + 1) + "- " + m.GirilenEn + "x" + m.GirilenBoy + "/" + m.GirilenAdet + " Adet"))</th>
                            <th colspan="4">@Html.DisplayFor(model => first.siparisModel.SistemTamami) @Html.DisplayFor(model => first.siparisModel.MusteriTamAdi)</th>
                        </tr>
                        <tr>
                            <th>Sipariş Numarası</th>
                            <th>@Html.DisplayFor(model => Model.First().siparisModel.Id)</th>
                            <th>Sipariş Tarihi</th>
                            <th colspan="2">@Html.Raw(string.Format("{0:dd/MM/yyyy}", Model.First().siparisModel.KayitTarihi))</th>
                            <th></th>
                            <th>Teslim Tarihi</th>
                            <th colspan="2">@Html.Raw(string.Format("{0:dd/MM/yyyy}", Model.First().siparisModel.TahminiTeslim))</th>
                        </tr>
                        <tr>
                            <th style="text-align:center;vertical-align:middle;width:60px;">Profil Kodu</th>
                            <th style="text-align:center;vertical-align:middle;">Profil Kesit</th>
                            <th style="text-align:center;vertical-align:middle;">Profil Adı</th>
                            <th style="text-align:center;vertical-align:middle;">Birim Ağırlık (gr)</th>
                            <th style="text-align:center;vertical-align:middle;">Kesilecek Profil Boy (mm)</th>
                            <th style="text-align:center;vertical-align:middle;">Kesim Planı</th>
                            <th style="text-align:center;vertical-align:middle;">Kesim Ölçüleri (mm)</th>
                            <th style="text-align:center;vertical-align:middle;width:60px;">Fire / Atık</th>
                        </tr>
                    </thead>
                    <tfoot>
                        <tr>
                            <th colspan=2>Toplam Atık</th>
                            <th colspan=2>Fire Stoğa Eklenen Toplam</th>
                            <th colspan=2>Asıl Stoktan Kullanılan Toplam</th>
                            <th colspan=2>Fire Stoktan Kullanılan Toplam</th>
                        </tr>
                        <tr>
                            <th>Uzunluk (Metre)</th>
                            <th>Ağırlık (Kg)</th>
                            <th>Uzunluk (Metre)</th>
                            <th>Ağırlık (Kg)</th>
                            <th>Uzunluk (Metre)</th>
                            <th>Ağırlık (Kg)</th>
                            <th>Uzunluk (Metre)</th>
                            <th>Ağırlık (Kg)</th>
                        </tr>
                        <tr>
                            <th>@Html.Raw(string.Format("{0:N2}", Model.First().optimizasyonList.First().ToplamAtikUzunluk))</th>
                            <th>@Html.Raw(string.Format("{0:N2}", Model.First().optimizasyonList.First().ToplamAtikAgirlik))</th>
                            <th>@Html.Raw(string.Format("{0:N2}", Model.First().optimizasyonList.First().FireyeEklenenToplamUzunluk))</th>
                            <th>@Html.Raw(string.Format("{0:N2}", Model.First().optimizasyonList.First().FireyeEklenenToplamAgirlik))</th>
                            <th>@Html.Raw(string.Format("{0:N2}", Model.First().optimizasyonList.First().AsilStoktanKullanilanToplamUzunluk))</th>
                            <th>@Html.Raw(string.Format("{0:N2}", Model.First().optimizasyonList.First().AsilStoktanKullanilanToplamAgirlik))</th>
                            <th>@Html.Raw(string.Format("{0:N2}", Model.First().optimizasyonList.First().FiredenKullanilanToplamUzunluk))</th>
                            <th>@Html.Raw(string.Format("{0:N2}", Model.First().optimizasyonList.First().FiredenKullanilanToplamAgirlik))</th>
                        </tr>
                    </tfoot>
                    <tbody>
                        @{
                            var fireLimit = Convert.ToInt32(ViewBag.minimumFire ?? 0);
                            var orderItems = Model.ToArray();
                            var profilPozMap = new System.Collections.Generic.Dictionary<int, int>();
                            for (int positionIndex = 0; positionIndex < orderItems.Length; positionIndex++) {
                                if (orderItems[positionIndex].profilList != null) {
                                    foreach (var pf in orderItems[positionIndex].profilList) {
                                        if (!profilPozMap.ContainsKey(pf.Id)) {
                                            profilPozMap[pf.Id] = positionIndex + 1;
                                        }
                                    }
                                }
                            }
                        }
                        @foreach (var item2 in optiList)
                        {
                            var pozLabel = "POZ1";
                            if (item2.ProfilId.HasValue && profilPozMap.ContainsKey(item2.ProfilId.Value)) {
                                pozLabel = "POZ" + profilPozMap[item2.ProfilId.Value];
                            }
                            <tr>
                                <td style="text-align:center;vertical-align:middle;">
                                    @(item2.profil != null ? item2.profil.ProfilKodu : "")
                                </td>
                                <td style="text-align:center;vertical-align:middle;">
                                    @if (item2.profil != null) {
                                        @Html.Raw("<img class='img-responsive img-thumbnailProf' src = '" + Url.Content("~/images/profilicons/" + item2.profil.ProfilFoto) + "' />")
                                    }
                                </td>
                                <td style="vertical-align:middle;">
                                    @(item2.profil != null ? item2.profil.ProfilAdi : "")
                                </td>
                                <td style="text-align:center;vertical-align:middle;">
                                    @(item2.profil != null && item2.profil.BirimAgirlik != null ? item2.profil.BirimAgirlik.Value.ToString() : "")
                                </td>
                                <td style="text-align:center;vertical-align:middle;">
                                    @(item2.KesimAdet + "x" + item2.ProfilBoy)
                                </td>
                                <td style="word-wrap:break-word;min-width:160px;max-width:220px;vertical-align:middle;">
                                    @Html.Raw(FormatKesimPlani(item2.KesilecekOlculer, pozLabel))
                                </td>
                                <td style="word-wrap: break-word;min-width: 140px;max-width: 180px;vertical-align:middle;">
                                    @Html.Raw(FormatKesimOlculer(item2.KesilecekOlculer, pozLabel))
                                </td>
                                @if ((item2.FireAtik ?? 0) > fireLimit)
                                {
                                    <th class="bg-light-green" style="text-align:center;vertical-align:middle;">@item2.FireAtik</th>
                                }
                                else
                                {
                                    <th class="bg-red" style="text-align:center;vertical-align:middle;">@item2.FireAtik</th>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <button type="button" onclick="PrintElem('optimizasyonyazdir')" class="btn bg-red waves-effect waves-light pull-right">
                <i class="material-icons">print</i>
                <span>YAZDIR</span>
            </button>
        </div>
            }
        </div>
    </div>
</div>
<div class="modal-footer">
    <button type="button" class="btn bg-black waves-effect waves-light" data-dismiss="modal">KAPAT</button>
</div>
