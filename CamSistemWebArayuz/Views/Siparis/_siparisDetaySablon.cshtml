                                            m2 = item.teklifToplamDetay.m2;
                                            teklif = item.teklifToplamDetay.Teklif;
                                        }
                                    }
                                    <tr>
                                        <th colspan="7" class="text-right">TOPLAM MALİYET</th>
                                        <th>@Html.Raw(string.Format("{0:c2}", toplamMaliyet.GetValueOrDefault(0)))</th>
                                    <tr>
                                        <th colspan="7" class="text-right">M2</th>
                                        <th>@Html.Raw(string.Format("{0:c2}", m2.GetValueOrDefault(0)))</th>
                                    <tr>
                                        <th colspan="7" class="text-right">TEKLİF</th>
                                        <th>@Html.Raw(string.Format("{0:c2}", teklif.GetValueOrDefault(0)))</th>
                                </tfoot>
                                <tbody>
                                    @if (item.teklifList != null)
                                    {
                                        foreach (var item2 in item.teklifList)

                                        {
                                            <tr>
                                                <td class="TeklifId">
                                                    <span>@Html.DisplayFor(modelItem => item2.Id)</span>
                                                </td>
                                                <td class="SiparisEnBoyAdetId">
                                                    <span>@Html.DisplayFor(modelItem => item2.SiparisEnBoyAdetId)</span>
                                                </td>
                                                <td class="Malzeme">
                                                    <span>@Html.DisplayFor(modelItem => item2.Malzeme)</span>
                                                    @*<input type="text" value="@item2.Malzeme" style="display:none" />*@
                                                </td>
                                                <td class="Birim">
                                                    <span>@Html.DisplayFor(modelItem => item2.Birim)</span>
                                                    <input type="text" value="@item2.Birim" style="display:none" />
                                                </td>
                                                <td class="Miktar">
                                                    <span>@Html.DisplayFor(modelItem => item2.Miktar)</span>
                                                    <input type="text" value="@item2.Miktar" style="display:none" />
                                                </td>
                                                <td class="BirimFiyat">
                                                    <span>@Html.Raw(string.Format("{0:c2}", item2.BirimFiyat))</span>
                                                    <input type="text" value="@item2.BirimFiyat" style="display:none" />
                                                </td>
                                                <td class="ToplamTutar">
                                                    <span>@Html.Raw(string.Format("{0:c2}", item2.ToplamTutar))</span>
                                                    @*<input type="text" value="@item2.ToplamTutar" style="display:none" />*@
                                                </td>
                                                <td>
                                                    @if (!ViewBag.raporMu)
                                                    {
                                                        <a class="Edit" href="javascript:;">Düzenle</a>
                                                        <a class="Update" href="javascript:;" style="display:none">Güncelle</a>
                                                        <a class="Cancel" href="javascript:;" style="display:none">Vazgeç</a>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>

                        <button type="button" onclick="PrintElem('maliyetyazdir_@item.Id')" class="btn bg-red waves-effect waves-light pull-right">
                            <i class="material-icons">print</i>
                            <span>YAZDIR</span>
                        </button>
                    </div>
                }
            </div>
        </div>
    </div>
    <div role="tabpanel" class="tab-pane fade" id="optimizasyon">
        <div class="modal-body">
            @* Model.First() patlamasın *@
            @{
                var first = Model != null ? Model.FirstOrDefault() : null;
                var optiList = (first != null) ? first.optimizasyonList : null;
                bool optiDataVar = (optiList != null && optiList.Count > 0);
            }

            @if (!optiDataVar)
            {
                @{
                    var optiSiparisId = first != null && first.siparisModel != null ? first.siparisModel.Id.ToString() : "";
                }

                <div id="optimizasyonContent">
                    <div style="text-align:center;padding:30px;color:#666;">
                        <i class="material-icons" style="font-size:48px;vertical-align:middle;">sync</i><br />
                        <span>Optimizasyon yükleniyor...</span>
                    </div>
                </div>

                @if (!(ViewBag.raporMu ?? false))
                {
                    <button type="button"
                            class="btn bg-blue waves-effect"
                            style="margin-top:10px;"
                            onclick="OptimizasyonHesapla('@optiSiparisId')">
                        OPTİMİZASYON YENİDEN HESAPLA
                    </button>
                }

                <script>
                    $(document).ready(function () {
                        $('a[href="#optimizasyon"]').one('shown.bs.tab', function () {
                            OptimizasyonHesapla('@optiSiparisId');
                        });
                    });
                </script>
            }
            else
            {
        <div class="tab-content">
            <div id="optimizasyonyazdir">
                @* SENİN MEVCUT OPTİMİZASYON TABLOSU BURADA AYNI KALABİLİR *@
                <table class="table table-bordered">

                    <thead>
                        <tr>
                            <th colspan=2 style="text-align:center;vertical-align:middle;padding:4px;"><img src="@Url.Content("~/images/logo.png")" style="max-width:100%;max-height:80px;object-fit:contain;display:block;margin:auto;" /></th>
                            <th colspan=5><center><h2><b>OPTİMİZASYON</b></h2></center></th>
                            <th colspan=2 style="word-wrap: break-word;max-width: 250px;">
                                @Html.DisplayFor(model => first.siparisModel.SistemTamami)
                            </th>
                        </tr>
                        <tr>
                            <th>İmalat Ölçüleri</th>
                            <th colspan="4">@string.Join(" | ", Model.Select(m => m.GirilenEn + "/" + m.GirilenBoy + "/" + m.GirilenAdet).Distinct())</th>
                            <th colspan="4">@Html.DisplayFor(model => Model.First().siparisModel.MusteriTamAdi)</th>
                        </tr>
                        <tr>
                            <th>Sipariş Numarası</th>
                            <th>@Html.DisplayFor(model => Model.First().siparisModel.Id)</th>
                            <th>Sipariş Tarihi</th>
                            <th colspan="2">@Html.Raw(string.Format("{0:dd/MM/yyyy}", Model.First().siparisModel.KayitTarihi))</th>
                            <th></th>
                            <th>Teslim Tarihi</th>
                            <th colspan="2">@Html.Raw(string.Format("{0:dd/MM/yyyy}", Model.First().siparisModel.TahminiTeslim))</th>
                        </tr>
                        <tr>
                            <th style="text-align:center;vertical-align:middle;width:60px;">Profil Kodu</th>
                            <th style="text-align:center;vertical-align:middle;">Profil Kesit</th>
                            <th style="text-align:center;vertical-align:middle;">Profil Adı</th>
                            <th style="text-align:center;vertical-align:middle;">Birim Ağırlık (gr)</th>
                            <th style="text-align:center;vertical-align:middle;">Kesilecek Profil Boy (mm)</th>
                            <th style="text-align:center;vertical-align:middle;">Kesim Planı</th>
                            <th style="text-align:center;vertical-align:middle;">Kesim Ölçüleri (mm)</th>
                            <th style="text-align:center;vertical-align:middle;width:60px;">Fire / Atık</th>
                        </tr>
                    </thead>
                    <tfoot>
                        <tr>
                            <th colspan=2>Toplam Atık</th>
                            <th colspan=2>Fire Stoğa Eklenen Toplam</th>
                            <th colspan=2>Asıl Stoktan Kullanılan Toplam</th>
                            <th colspan=2>Fire Stoktan Kullanılan Toplam</th>
                        </tr>
                        <tr>
                            <th>Uzunluk (Metre)</th>
                            <th>Ağırlık (Kg)</th>
                            <th>Uzunluk (Metre)</th>
                            <th>Ağırlık (Kg)</th>
                            <th>Uzunluk (Metre)</th>
                            <th>Ağırlık (Kg)</th>
                            <th>Uzunluk (Metre)</th>
                            <th>Ağırlık (Kg)</th>
                        </tr>
                        <tr>
                            <th>@Html.Raw(string.Format("{0:N2}", Model.First().optimizasyonList.First().ToplamAtikUzunluk))</th>
                            <th>@Html.Raw(string.Format("{0:N2}", Model.First().optimizasyonList.First().ToplamAtikAgirlik))</th>
                            <th>@Html.Raw(string.Format("{0:N2}", Model.First().optimizasyonList.First().FireyeEklenenToplamUzunluk))</th>
                            <th>@Html.Raw(string.Format("{0:N2}", Model.First().optimizasyonList.First().FireyeEklenenToplamAgirlik))</th>
                            <th>@Html.Raw(string.Format("{0:N2}", Model.First().optimizasyonList.First().AsilStoktanKullanilanToplamUzunluk))</th>
                            <th>@Html.Raw(string.Format("{0:N2}", Model.First().optimizasyonList.First().AsilStoktanKullanilanToplamAgirlik))</th>
                            <th>@Html.Raw(string.Format("{0:N2}", Model.First().optimizasyonList.First().FiredenKullanilanToplamUzunluk))</th>
                            <th>@Html.Raw(string.Format("{0:N2}", Model.First().optimizasyonList.First().FiredenKullanilanToplamAgirlik))</th>
                        </tr>
                    </tfoot>
                    <tbody>
                        @foreach (var item2 in optiList)
                        {
                            <tr>
                                <td style="text-align:center;vertical-align:middle;">
                                    @Html.DisplayFor(modelItem => item2.profil.ProfilKodu)
                                </td>
                                <td style="text-align:center;vertical-align:middle;">
                                    @Html.Raw("<img class='img-responsive img-thumbnailProf' src = '" + Url.Content("~/images/profilicons/" + item2.profil.ProfilFoto) + "' />")
                                </td>
                                <td style="vertical-align:middle;">
                                    @Html.DisplayFor(modelItem => item2.profil.ProfilAdi)
                                </td>
                                <td style="text-align:center;vertical-align:middle;">
                                    @Html.DisplayFor(modelItem => item2.profil.BirimAgirlik)
                                </td>
                                <td style="text-align:center;vertical-align:middle;">
                                    @(item2.KesimAdet + "x" + item2.ProfilBoy)
                                </td>
                                <td style="word-wrap:break-word;min-width:160px;max-width:220px;vertical-align:middle;">
                                    @Html.Raw(FormatKesimPlani(item2.KesilecekOlculer))
                                </td>
                                <td style="word-wrap: break-word;min-width: 140px;max-width: 180px;vertical-align:middle;">
                                    @FormatKesimOlculer(item2.KesilecekOlculer)
                                </td>
                                @{
                                    var limit = ViewBag.minimumFire;

                                    if (item2.FireAtik > limit)
                                    {

                                        @Html.Raw("<th class='bg-light-green' style='text-align:center;vertical-align:middle;'>")
                                    }
                                    else
                                    {
                                        @Html.Raw("<th class='bg-red' style='text-align:center;vertical-align:middle;'>")
                                    }
                                    @Html.Raw(item2.FireAtik)
                                    @Html.Raw("</th>")
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <button type="button" onclick="PrintElem('optimizasyonyazdir')" class="btn bg-red waves-effect waves-light pull-right">
                <i class="material-icons">print</i>
                <span>YAZDIR</span>
            </button>
        </div>
            }
        </div>
    </div>
</div>
<div class="modal-footer">
    <button type="button" class="btn bg-black waves-effect waves-light" data-dismiss="modal">KAPAT</button>
</div>
