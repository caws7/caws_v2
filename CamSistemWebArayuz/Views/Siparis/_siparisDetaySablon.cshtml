@model IEnumerable<CamSistemDataLayer.Models.SiparisEnBoyAdet>
@using CamSistemWebArayuz.Models;
@using System.Linq;

@functions {
    string FormatKesimOlculer(string olcular)
    {
        if (string.IsNullOrEmpty(olcular)) return "";
        var parts = olcular.Split(',').Select(s => s.Trim()).Where(s => !string.IsNullOrEmpty(s)).ToList();
        var grouped = parts.GroupBy(x => x)
                           .Select(g => g.Count() + "x" + g.Key);
        return string.Join(", ", grouped);
    }

    string FormatKesimPlani(string olcular)
    {
        if (string.IsNullOrEmpty(olcular)) return "";
        var cuts = olcular.Split(',').Select(s => s.Trim()).Where(s => !string.IsNullOrEmpty(s)).ToList();
        var sb = new System.Text.StringBuilder();
        sb.Append("<span style='color:red;font-weight:bold;'>(4)</span>");
        foreach (var cut in cuts)
        {
            sb.Append("," + cut + ",<span style='color:red;font-weight:bold;'>(4)</span>");
        }
        return sb.ToString();
    }
}

