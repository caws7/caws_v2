@model IEnumerable<CamSistemDataLayer.Models.SiparisEnBoyAdet>
@using CamSistemWebArayuz.Models;
@using System.Linq;

@functions {
    string FormatKesimOlculer(string olcular, string pozLabel = "POZ1")
    {
        if (string.IsNullOrEmpty(olcular)) return "";
        var pozHtml = "<span style='color:green;font-weight:bold;'>[" + pozLabel + "]</span>";
        var parts = olcular.Split(',').Select(s => s.Trim()).Where(s => !string.IsNullOrEmpty(s)).ToList();
        var grouped = parts.GroupBy(x => x)
                           .Select(g => pozHtml + g.Count() + "x" + g.Key);
        return string.Join(", ", grouped);
    }

    string FormatKesimPlani(string olcular, string pozLabel = "POZ1")
    {
        if (string.IsNullOrEmpty(olcular)) return "";
        var pozHtml = "<span style='color:green;font-weight:bold;'>[" + pozLabel + "]</span>";
        var cuts = olcular.Split(',').Select(s => s.Trim()).Where(s => !string.IsNullOrEmpty(s)).ToList();
        var sb = new System.Text.StringBuilder();
        sb.Append("<span style='color:red;font-weight:bold;'>(4)</span>");
        foreach (var cut in cuts)
        {
            sb.Append("," + pozHtml + cut + ",<span style='color:red;font-weight:bold;'>(4)</span>");
        }
        return sb.ToString();
    }
}

<style>
    .modal-body {
        overflow: auto;
    }

    .nav {
        padding-left: revert;
    }
</style>
<div id="siparisTeklifAntiForgeryToken" style="display:none;">
    @Html.AntiForgeryToken()
</div>

<script>
    var KAR_PAYI_METNI = 'KAR PAYI';

    function OptimizasyonHesapla(siparisId, _retryCount) {
        if (!siparisId) {
            Swal.fire("Hata", "Sipariş ID bulunamadı.", "error");
            return;
        }

        var retryCount = _retryCount || 0;
        $("#optimizasyonContent").html('<div style="text-align:center;padding:20px;color:#666;"><i class="material-icons" style="font-size:36px;vertical-align:middle;">sync</i> Hesaplanıyor...</div>');

        $.ajax({
            type: "POST",
            url: '@Url.Action("OptimizasyonHesapla", "Siparis")',
            data: { SiparisId: siparisId },
            timeout: 300000 // 5-minute timeout to allow for longer optimization computations
        }).done(function (html) {
            $("#optimizasyonContent").html(html);
        }).fail(function (xhr) {
            if (xhr.status === 500 && retryCount < 1) {
                // Optimizer may have completed on server side; retry to fetch the saved result
                setTimeout(function () { OptimizasyonHesapla(siparisId, 1); }, 2000);
            } else {
                $("#optimizasyonContent").html('<div class="alert alert-danger">Optimizasyon hesaplanamadı. Lütfen yeniden deneyin.</div>');
            }
        });
    }

    function dosyaSil(_this, _Id, _siparisId, _tur) {
        Swal.fire({
            title: 'Emin misin?',
            text: 'Bu kaydı silmek istediğine emin misin?',
            icon: 'warning',
            cancelButtonText: 'Vazgeç',
            showCancelButton: true,
            confirmButtonColor: '#3085d6',
            cancelButtonColor: '#d33',
            confirmButtonText: 'Evet, sil!'
        }).then((result) => {
            if (result.isConfirmed) {
                $.ajax({
                    type: 'POST',
                    url: '@Url.Action("DosyaSil", "Siparis")',
                    contentType: 'application/json; charset=utf-8',
                    dataType: 'json',
                    data: '{ "dosyaId":"' + _Id + '", "siparisId":"' + _siparisId + '", "dosyaTur":"' + _tur + '"}',
                    success: function (data) {
                        if (data == 'OK') {
                            $(_this).closest("tr").remove();
                            Swal.fire({
                                position: 'top-end',
                                icon: 'success',
                                title: 'Silme işlemi başarıyla gerçekleştirildi.',
                                showConfirmButton: false,
                                timer: 1500
                            })
                        }
                    },
                    error: function (err) {
                        console.log(err);
                    }
                });
            }
        });
    }

    function maliyetParseDecimal(value) {
        if (value === null || value === undefined) return null;
        var text = (value + '').trim().replace(/₺/g, '').replace(/\s/g, '');
        if (text === '') return null;
        if (text.indexOf(',') > -1 && text.indexOf('.') > -1) {
            text = text.replace(/\./g, '').replace(',', '.');
        } else if (text.indexOf(',') > -1) {
            text = text.replace(',', '.');
        }
        var parsed = parseFloat(text);
        return isNaN(parsed) ? null : parsed;
    }

    function maliyetFormatCurrency(value) {
        return new Intl.NumberFormat('tr-TR', { style: 'currency', currency: 'TRY' }).format(value || 0);
    }

    function maliyetToggleEditRow($row, editMode) {
        $row.find('.Edit').toggle(!editMode);
        $row.find('.Update,.Cancel').toggle(editMode);
        $row.find('.BirimFiyat span,.Miktar span,.ToplamTutar span').toggle(!editMode);
        $row.find('.BirimFiyat input,.Miktar input').toggle(editMode);

        var isKarPayi = (($row.find('.Malzeme span').text() || '').trim().toUpperCase() === KAR_PAYI_METNI);
        $row.find('.ToplamTutar input').toggle(editMode && isKarPayi);
    }

    function maliyetSetFooterValues($table, toplamMaliyet, m2, teklif) {
        $table.find('[data-role="toplamMaliyet"]').text(maliyetFormatCurrency(toplamMaliyet));
        $table.find('[data-role="m2"]').text(maliyetFormatCurrency(m2));
        $table.find('[data-role="teklif"]').text(maliyetFormatCurrency(teklif));
    }

    $(document).ready(function () {
        $(document).off('click.maliyetEdit', '.maliyet-table .Edit').on('click.maliyetEdit', '.maliyet-table .Edit', function () {
            var $row = $(this).closest('tr');
            $row.find('input').each(function () { $(this).data('old-value', $(this).val()); });
            maliyetToggleEditRow($row, true);
        });

        $(document).off('click.maliyetCancel', '.maliyet-table .Cancel').on('click.maliyetCancel', '.maliyet-table .Cancel', function () {
            var $row = $(this).closest('tr');
            $row.find('input').each(function () {
                var oldValue = $(this).data('old-value');
                if (oldValue !== undefined) $(this).val(oldValue);
            });
            maliyetToggleEditRow($row, false);
        });

        $(document).off('click.maliyetUpdate', '.maliyet-table .Update').on('click.maliyetUpdate', '.maliyet-table .Update', function () {
            var $row = $(this).closest('tr');
            var $table = $row.closest('.maliyet-table');
            var teklifId = $.trim($row.find('.TeklifId span').text());
            var birimFiyat = maliyetParseDecimal($row.find('.BirimFiyat input').val());
            var miktar = maliyetParseDecimal($row.find('.Miktar input').val());
            var toplamTutarInput = maliyetParseDecimal($row.find('.ToplamTutar input').val());
            var isKarPayi = (($row.find('.Malzeme span').text() || '').trim().toUpperCase() === KAR_PAYI_METNI);
            var antiForgeryToken = $('#siparisTeklifAntiForgeryToken input[name="__RequestVerificationToken"]').val();

            if (birimFiyat === null || birimFiyat < 0) {
                Swal.fire("Uyarı", "Lütfen geçerli bir birim fiyat giriniz.", "warning");
                return;
            }
            if (miktar === null || miktar < 0) {
                Swal.fire("Uyarı", "Lütfen geçerli bir miktar giriniz.", "warning");
                return;
            }

            if (!isKarPayi) {
                toplamTutarInput = miktar * birimFiyat;
            } else if (toplamTutarInput === null || toplamTutarInput < 0) {
                toplamTutarInput = miktar * birimFiyat;
            }

            $.ajax({
                url: '@Url.Action("SiparisTeklifSatiriGuncelle", "Siparis")',
                type: 'POST',
                dataType: 'json',
                data: {
                    TeklifId: teklifId,
                    BirimFiyat: birimFiyat,
                    Miktar: miktar,
                    ToplamTutar: toplamTutarInput,
                    __RequestVerificationToken: antiForgeryToken
                }
            }).done(function (data) {
                if (data && data.Result === "OK") {
                    $row.find('.BirimFiyat span').text(maliyetFormatCurrency(data.BirimFiyat));
                    $row.find('.Miktar span').text((data.Miktar || 0).toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }));
                    $row.find('.ToplamTutar span').text(maliyetFormatCurrency(data.ToplamTutar));
                    $row.find('.BirimFiyat input').val(data.BirimFiyat);
                    $row.find('.Miktar input').val(data.Miktar);
                    $row.find('.ToplamTutar input').val(data.ToplamTutar);
                    maliyetSetFooterValues($table, data.ToplamMaliyet, data.M2, data.Teklif);
                    maliyetToggleEditRow($row, false);
                } else {
                    Swal.fire("Hata", (data && data.Message) ? data.Message : "Güncelleme sırasında hata oluştu.", "error");
                }
            }).fail(function () {
                Swal.fire("Hata", "Güncelleme sırasında sunucu hatası oluştu.", "error");
            });
        });

          $('#aciklamaDosyaKaydet').click(function () {

            // Checking whether FormData is available in browser
            if (window.FormData !== undefined) {

                var siparisId = $("#siparisId").val();
                var fileUpload = $("#aciklamaDosyaInputId").get(0);
                var files = fileUpload.files;

                var fileData = new FormData();

                for (var i = 0; i < files.length; i++) {
                    fileData.append(files[i].name, files[i]);
                }
                fileData.append('siparisId', siparisId);

                $.ajax({
                    url: '@Url.Action("AciklamaDosyaYukleme", "Siparis")',
                    type: "POST",
                    contentType: false, // Not to set any content header
                    processData: false, // Not to process data
                    data: fileData,
                    success: function (data) {
                        if (data.result == "OK") {
                            Swal.fire({
                                title: 'Başarılı!',
                                text: 'Dosya yükleme işlemi başarıyla gerçekleştirildi!',
                                icon: 'success',
                                timer: 1500
                            }).then(() => {
                                window.location.href = '@Url.Action("Index", "Siparis")';
                            });
                            $('#showDuzenleModal').modal('toggle');
                            window.setTimeout(function () { location.reload() }, 1800)
                        } else if (data.result == "NOK") {
                            $('#aciklamaDosyaInputId').val('');
                            $('#result').html(data.mesaj);
                        } else if (data.result == "WOK") {
                            $('#aciklamaDosyaInputId').val('');
                            $('#result').html(data.mesaj);
                        }
                    },
                    error: function (err) {
                        alert(err.statusText);
                    }
                });
            } else {
                alert("FormData is not supported.");
            }
        });
    });
</script>

