@model CamSistemDataLayer.Models.Siparis
@{
    ViewBag.Title = "CamSistem - Sipariş Yönetimi";
    Layout = "~/Views/Shared/_HomeLayout.cshtml";
}

<style>
    .siparis-row {
        border: 1px solid #e0e0e0;
        border-radius: 6px;
        padding: 10px 12px;
        margin-bottom: 8px;
        background: #fafafa;
    }
    .siparis-row .olcu-group {
        display: inline-block;
        margin-right: 6px;
        vertical-align: top;
    }
    .siparis-row .olcu-group label {
        font-size: 11px;
        color: #777;
        display: block;
        margin-bottom: 2px;
    }
    .siparis-row .olcu-group input {
        width: 90px;
    }
    .siparis-row select.row-sistem,
    .siparis-row select.row-altsistem,
    .siparis-row select.row-kasa,
    .siparis-row select.row-sistemtur {
        min-width: 180px;
        max-width: 33%;
        width: 33%;
        display: inline-block;
        margin-right: 6px;
        vertical-align: top;
    }
    .row-poz-label {
        display: inline-block;
        writing-mode: vertical-rl;
        transform: rotate(180deg);
        text-align: center;
        font-weight: bold;
        font-size: 13px;
        color: #388e3c;
        margin-right: 8px;
        min-width: 20px;
        vertical-align: top;
        padding-top: 4px;
    }
    .row-actions {
        display: inline-block;
        vertical-align: top;
        padding-top: 18px;
    }
    .row-actions .btn {
        margin-right: 4px;
    }
    .siparis-rows-container {
        min-height: 60px;
    }
    .olcu-section {
        display: inline-block;
        vertical-align: top;
    }
</style>

<div class="row clearfix">
    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
        <div class="card">
            <div class="header">
                <h2>Yeni Sipariş Oluştur</h2>
            </div>
            <div class="body">
                <div id="siparisRowsContainer" class="siparis-rows-container">
                    <!-- Rows will be added here by JS -->
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row clearfix">
    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
        <div class="card">
            <div class="body">
                <div class="row clearfix">
                    <button type="button" id="siparisKaydetForm" class="btn bg-green waves-effect">KAYDET</button>
                    <button type="button" class="btn bg-black waves-effect waves-light" onclick="location.href='@Url.Action("Index", "Siparis")'">SİPARİŞ LİSTESİNE DÖN</button>
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts {
<script>
(function ($) {

    // ============ HELPERS ============
    var SURME_ALT_SISTEM_IDS = ["1012", "1013", "1014", "1015"];
    var SURME_STANDART_IDS   = ["1012", "1013"];
    var SURME_TEK_KOSE_IDS   = ["1014"];
    var SURME_CIFT_KOSE_IDS  = ["1015"];

    function isSurmeAltSistem(id) { return SURME_ALT_SISTEM_IDS.includes(String(id)); }

    var rowIndex = 0;

    // Build HTML for one row
    function buildRowHtml(idx, pozNum) {
        var sistemOptions = '<option value="">Sistem Seçiniz...</option>';
        @foreach (var s in ViewBag.Sistemler)
        {
            @:sistemOptions += '<option value="@s.Id">@Html.Raw(s.SistemAdi)</option>';
        }

        return '<div class="siparis-row" id="row_' + idx + '" data-row-index="' + idx + '">'
            // POZ label (vertical)
            + '<span class="row-poz-label" data-poz-num="' + pozNum + '">POZ' + pozNum + '</span>'
            // Sistem
            + '<select class="form-control row-sistem" data-row="' + idx + '" style="min-width:170px;display:inline-block;vertical-align:top;margin-right:6px;">'
            + sistemOptions
            + '</select>'
            // Alt Sistem (hidden by default)
            + '<select class="form-control row-altsistem" data-row="' + idx + '" style="min-width:170px;display:none;vertical-align:top;margin-right:6px;">'
            + '<option value="">Alt Sistem Seçiniz...</option>'
            + '</select>'
            // Kasa (hidden by default)
            + '<select class="form-control row-kasa" data-row="' + idx + '" style="min-width:160px;display:none;vertical-align:top;margin-right:6px;">'
            + '<option value="">Kasa Seçiniz...</option>'
            + '<option value="3 lü kasa">3 lü kasa</option>'
            + '<option value="5 li kasa">5 li kasa</option>'
            + '</select>'
            // Sistem Tür (hidden by default)
            + '<select class="form-control row-sistemtur" data-row="' + idx + '" style="min-width:160px;display:none;vertical-align:top;margin-right:6px;">'
            + '<option value="">Sistem Türü Seçiniz...</option>'
            + '</select>'
            // Ölçü alanları (hidden until system selected)
            + '<span class="olcu-section row-olcu-wrapper" data-row="' + idx + '" style="display:none;">'
            // Normal: En, Boy, Adet
            + '<span class="olcu-group row-en-grp">'
            + '<label>En (mm)</label>'
            + '<input type="text" class="form-control row-en" data-row="' + idx + '" onkeypress="return isNumberKey(event)" placeholder="En">'
            + '</span>'
            // SolEn/En2 (for Cam Çatı açınım + Sürme köşe)
            + '<span class="olcu-group row-soLen-grp" style="display:none;">'
            + '<label class="row-soLen-label">En-2 (mm)</label>'
            + '<input type="text" class="form-control row-soLen" data-row="' + idx + '" onkeypress="return isNumberKey(event)" placeholder="En-2">'
            + '</span>'
            // En3 (for Sürme çift köşe)
            + '<span class="olcu-group row-en3-grp" style="display:none;">'
            + '<label>En-3 (mm)</label>'
            + '<input type="text" class="form-control row-en3" data-row="' + idx + '" onkeypress="return isNumberKey(event)" placeholder="En-3">'
            + '</span>'
            // Boy
            + '<span class="olcu-group row-boy-grp">'
            + '<label class="row-boy-label">Yükseklik (mm)</label>'
            + '<input type="text" class="form-control row-boy" data-row="' + idx + '" onkeypress="return isNumberKey(event)" placeholder="Boy">'
            + '</span>'
            // Kanat Adet (for Sürme)
            + '<span class="olcu-group row-kanat-grp" style="display:none;">'
            + '<label>Kanat Adet</label>'
            + '<input type="text" class="form-control row-kanat" data-row="' + idx + '" onkeypress="return isNumberKey(event)" placeholder="Kanat">'
            + '</span>'
            // Sistem Adet
            + '<span class="olcu-group row-adet-grp">'
            + '<label>Sistem Adet</label>'
            + '<input type="text" class="form-control row-adet" data-row="' + idx + '" onkeypress="return isNumberKey(event)" placeholder="Adet">'
            + '</span>'
            + '</span>'
            // Action buttons
            + '<span class="row-actions">'
            + '<button type="button" class="btn bg-green btn-circle waves-effect waves-circle waves-float btn-add-row" title="Yeni Satır Ekle"><i class="material-icons">add</i></button>'
            + '<button type="button" class="btn bg-red btn-circle waves-effect waves-circle waves-float btn-remove-row" title="Satırı Sil"><i class="material-icons">delete</i></button>'
            + '</span>'
            + '</div>';
    }

    function updatePozLabel(idx) {
        var rowSel = '#row_' + idx;
        var label = $(rowSel + ' .row-poz-label');
        var pozNum = label.data('poz-num');
        var en = $(rowSel + ' .row-en').val();
        var boy = $(rowSel + ' .row-boy').val();
        var adet = $(rowSel + ' .row-adet').val();
        var newText = 'POZ' + pozNum;
        if (en && boy && adet) {
            newText += '- ' + en + 'x' + boy + '/' + adet + ' Adet';
        }
        label.text(newText);
    }

    function renumberRows() {
        var pozNum = 1;
        $('.siparis-row').each(function () {
            var row = $(this);
            var idx = row.data('row-index');
            var label = row.find('.row-poz-label');
            label.data('poz-num', pozNum);
            var en = row.find('.row-en').val();
            var boy = row.find('.row-boy').val();
            var adet = row.find('.row-adet').val();
            var newText = 'POZ' + pozNum;
            if (en && boy && adet) {
                newText += '- ' + en + 'x' + boy + '/' + adet + ' Adet';
            }
            label.text(newText);
            pozNum++;
        });
    }

    function addRow() {
        var pozNum = $('.siparis-row').length + 1;
        var html = buildRowHtml(rowIndex, pozNum);
        $('#siparisRowsContainer').append(html);
        bindRow(rowIndex);
        rowIndex++;
    }

    function bindRow(idx) {
        var rowSel = '#row_' + idx;
        // Sistem change
        $(rowSel + ' .row-sistem').on('change', function () {
            rowSistemChanged(idx, $(this).val());
        });
        // AltSistem change
        $(rowSel + ' .row-altsistem').on('change', function () {
            rowAltSistemChanged(idx, $(this).val());
        });
        // Update POZ label when En, Boy, Adet change
        $(rowSel + ' .row-en, ' + rowSel + ' .row-boy, ' + rowSel + ' .row-adet').on('input change', function () {
            updatePozLabel(idx);
        });
    }

    function rowSistemChanged(idx, sistemId) {
        var rowSel = '#row_' + idx;

        // Reset alt/tur dropdowns
        $(rowSel + ' .row-altsistem').hide().val('');
        $(rowSel + ' .row-kasa').hide().val('');
        $(rowSel + ' .row-sistemtur').hide().val('');

        if (!sistemId || sistemId === '') {
            $(rowSel + ' .row-olcu-wrapper').hide();
            return;
        }

        // Cam Çatı (sistem=2)
        if (sistemId === '2') {
            $(rowSel + ' .row-olcu-wrapper').show();
            // Cam çatı: En=Genişlik, SolEn=Açınım, Boy=OlukAltı Yüks, Adet=KanatSayısı
            $(rowSel + ' .row-soLen-grp').show();
            $(rowSel + ' .row-soLen-label').text('Sistem Açınım');
            $(rowSel + ' .row-en-grp label').text('Sistem Genişlik');
            $(rowSel + ' .row-boy-label').text('Oluk Altı Yükseklik');
            $(rowSel + ' .row-adet-grp label').text('Kanat Sayısı');
            $(rowSel + ' .row-en3-grp').hide();
            $(rowSel + ' .row-kanat-grp').hide();
        }

        var url = '@Url.Action("SistemAltturGetir", "Siparis")';
        $.ajax({
            url: url,
            data: { SistemId: sistemId },
            type: 'POST',
            cache: false,
            success: function (data) {
                var turKontrol = data.SistemTuruVarMi;
                if (sistemId === '4' || sistemId === '2') turKontrol = false; // Sürme and Cam Çatı have no sistem türü

                if (turKontrol) {
                    // Show SistemTur dropdown
                    var $tur = $(rowSel + ' .row-sistemtur');
                    $tur.find('option').remove();
                    $tur.append('<option value="">Sistem Türü Seçiniz...</option>');
                    $.each(data.SistemTurListesi, function (i, t) {
                        $tur.append('<option value="' + t.Value + '">' + t.Text + '</option>');
                    });
                    $tur.show();
                    $(rowSel + ' .row-olcu-wrapper').hide();
                } else {
                    // Show AltSistem dropdown (fill options from ajax)
                    var $alt = $(rowSel + ' .row-altsistem');
                    $alt.find('option').remove();
                    $alt.append('<option value="">Alt Sistem Seçiniz...</option>');
                    $.each(data.AltSistemListesi, function (i, a) {
                        $alt.append('<option value="' + a.Value + '">' + a.Text + '</option>');
                    });

                    if (data.AltSistemListesi && data.AltSistemListesi.length > 0 && sistemId === '4') {
                        $alt.show();
                        $(rowSel + ' .row-olcu-wrapper').hide();
                    } else {
                        // No alt sistem needed, show ölçü directly (but not for Cam Çatı which is already configured)
                        $alt.hide();
                        if (sistemId !== '2') showNormalOlcu(idx);
                    }
                }
            },
            error: function () {
                // If ajax fails, still show ölçü area for non-sürme
                if (sistemId !== '4') showNormalOlcu(idx);
            }
        });
    }

    function rowAltSistemChanged(idx, altSistemId) {
        var rowSel = '#row_' + idx;
        if (!altSistemId || altSistemId === '') {
            $(rowSel + ' .row-kasa').hide().val('');
            $(rowSel + ' .row-olcu-wrapper').hide();
            return;
        }

        $(rowSel + ' .row-kasa').hide().val('');
        $(rowSel + ' .row-olcu-wrapper').show();
        // Reset all extra fields
        $(rowSel + ' .row-soLen-grp').hide();
        $(rowSel + ' .row-en3-grp').hide();
        $(rowSel + ' .row-kanat-grp').hide();
        // Reset labels
        $(rowSel + ' .row-en-grp label').text('En (mm)');
        $(rowSel + ' .row-boy-label').text('Yükseklik (mm)');
        $(rowSel + ' .row-adet-grp label').text('Sistem Adet');

        if (SURME_STANDART_IDS.includes(String(altSistemId))) {
            $(rowSel + ' .row-kasa').show();
            $(rowSel + ' .row-kanat-grp').show();
        } else if (SURME_TEK_KOSE_IDS.includes(String(altSistemId))) {
            $(rowSel + ' .row-kasa').show();
            $(rowSel + ' .row-soLen-grp').show();
            $(rowSel + ' .row-soLen-label').text('En-2 (mm)');
            $(rowSel + ' .row-kanat-grp').show();
        } else if (SURME_CIFT_KOSE_IDS.includes(String(altSistemId))) {
            $(rowSel + ' .row-kasa').show();
            $(rowSel + ' .row-soLen-grp').show();
            $(rowSel + ' .row-soLen-label').text('En-2 (mm)');
            $(rowSel + ' .row-en3-grp').show();
            $(rowSel + ' .row-kanat-grp').show();
        }
    }

    function showNormalOlcu(idx) {
        var rowSel = '#row_' + idx;
        $(rowSel + ' .row-olcu-wrapper').show();
        $(rowSel + ' .row-soLen-grp').hide();
        $(rowSel + ' .row-en3-grp').hide();
        $(rowSel + ' .row-kanat-grp').hide();
        $(rowSel + ' .row-kasa').hide().val('');
        $(rowSel + ' .row-en-grp label').text('En (mm)');
        $(rowSel + ' .row-boy-label').text('Yükseklik (mm)');
        $(rowSel + ' .row-adet-grp label').text('Sistem Adet');
    }

    // When SistemTur is selected in a row, show ölçü
    $(document).on('change', '.row-sistemtur', function () {
        var idx = $(this).data('row');
        var rowSel = '#row_' + idx;
        if ($(this).val()) {
            showNormalOlcu(idx);
        } else {
            $(rowSel + ' .row-olcu-wrapper').hide();
        }
    });

    // Add row button
    $(document).on('click', '.btn-add-row', function () {
        addRow();
    });

    // Remove row button
    $(document).on('click', '.btn-remove-row', function () {
        var rowDiv = $(this).closest('.siparis-row');
        if ($('.siparis-row').length > 1) {
            rowDiv.remove();
            renumberRows();
        } else {
            alert('En az bir satır olmalıdır!');
        }
    });

    // ============ KAYDET ============
    $('#siparisKaydetForm').click(function (e) {
        e.preventDefault();

        var items = [];
        var hasError = false;

        $('.siparis-row').each(function () {
            var row = $(this);
            var idx = row.data('row-index');
            var sistemId = row.find('.row-sistem').val();
            var altSistemId = row.find('.row-altsistem').is(':visible') ? row.find('.row-altsistem').val() : null;
            var kasaTipi = row.find('.row-kasa').is(':visible') ? row.find('.row-kasa').val() : null;
            var sistemTurId = row.find('.row-sistemtur').is(':visible') ? row.find('.row-sistemtur').val() : null;

            var en = row.find('.row-en').val();
            var soLen = row.find('.row-soLen-grp').is(':visible') ? row.find('.row-soLen').val() : '0';
            var en3 = row.find('.row-en3-grp').is(':visible') ? row.find('.row-en3').val() : '0';
            var boy = row.find('.row-boy').val();
            var kanat = row.find('.row-kanat-grp').is(':visible') ? row.find('.row-kanat').val() : '0';
            var adet = row.find('.row-adet').val();

            if (!sistemId) {
                alert((idx + 1) + '. satırda Sistem seçiniz!');
                hasError = true;
                return false;
            }
            if (!en || !boy || !adet) {
                alert((idx + 1) + '. satırda En, Boy ve Adet alanlarını doldurunuz!');
                hasError = true;
                return false;
            }
            if (isSurmeAltSistem(altSistemId) && (!kanat || kanat === '0')) {
                alert((idx + 1) + '. satırda Sürme sistemlerde Kanat Adedi boş olamaz!');
                hasError = true;
                return false;
            }
            if (isSurmeAltSistem(altSistemId) && !kasaTipi) {
                alert((idx + 1) + '. satırda Kasa seçiniz!');
                hasError = true;
                return false;
            }

            items.push({
                GirilenEn: parseInt(en) || 0,
                GirilenSolEn: parseInt(soLen) || 0,
                GirilenEn3: parseInt(en3) || 0,
                GirilenBoy: parseInt(boy) || 0,
                GirilenKanatAdet: parseInt(kanat) || 0,
                GirilenAdet: parseInt(adet) || 0,
                SistemId: parseInt(sistemId) || 0,
                AltSistemId: parseInt(altSistemId) || 0,
                SistemTurId: parseInt(sistemTurId) || 0,
                KasaTipi: kasaTipi || null
            });
        });

        if (hasError || items.length === 0) return;

        var firstItem = items[0];
        var SiparisModel = {
            AltSistemId: firstItem.AltSistemId,
            SistemId: firstItem.SistemId,
            SistemTurId: firstItem.SistemTurId
        };

        $.ajax({
            type: 'POST',
            data: JSON.stringify({ enBoyAdet: items, siparis: SiparisModel }),
            url: '@Url.Action("SiparisKaydet", "Siparis")',
            dataType: "json",
            contentType: 'application/json; charset=utf-8',
            success: function (data) {
                if (data === 'OK') {
                    location.href = '/Siparis/Index';
                } else {
                    alert('Kayıt başarısız: ' + data);
                }
            },
            error: function (errorObj) {
                alert('Hata: ' + errorObj.responseText);
            }
        });
    });

    // ============ INIT ============
    $(function () {
        addRow(); // Add first row on page load
    });

})(jQuery);
</script>
}