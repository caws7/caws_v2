@model CamSistemWebArayuz.Models.ImalatModel
<style>
    .modal-body {
        overflow: auto;
    }

    .nav {
        padding-left: revert;
    }

    .highlightred td {
        /*
      Since you're changing only the
      border-color, you only need to
      redefine the border-color.
    */
        border-color: red;
    }
</style>
<ul class="nav nav-tabs tab-nav-right tab-col-red" role="tablist">
    <li role="presentation" class="active"><a href="#sonuc" data-toggle="tab"><b>OPTİMİZASYON SONUCU</b></a></li>
    @* <li role="presentation"><a href="#stok" data-toggle="tab"><b>STOK DURUMU</b></a></li>*@
</ul>
<!-- Tab panes -->
<div class="tab-content">
    <div role="tabpanel" class="tab-pane fade in active" id="sonuc">
        <div id="imalatyazdir">
            <div class="modal-body">
                <table class="table table-bordered">
                    <thead>
                        <tr>
                            <th style="text-align:center;vertical-align:middle;min-width:60px;max-width:80px;padding:4px 3px;">Profil Kodu</th>
                            <th style="text-align:center;vertical-align:middle;">Profil Kesit</th>
                            <th style="text-align:center;vertical-align:middle;">Profil Adı</th>
                            <th style="text-align:center;vertical-align:middle;">Birim Ağırlık (gr)</th>
                            <th style="text-align:center;vertical-align:middle;">Kesilecek Profil Boy (mm)</th>
                            <th style="text-align:center;vertical-align:middle;">Kesim Planı</th>
                            <th style="text-align:center;vertical-align:middle;">Kesim Ölçüleri (mm)</th>
                            <th style="text-align:center;vertical-align:middle;">Kesilecek Profil Boy Adedi</th>
                            <th style="text-align:center;vertical-align:middle;min-width:50px;max-width:70px;padding:4px 3px;">Fire / Atık</th>
                            <th style="text-align:center;vertical-align:middle;">Eksik Adet</th>
                            <th style="text-align:center;vertical-align:middle;">Mevcut Stok Miktarı</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.optiSonuc)
                        {
                            <tr>
                                <td style="text-align:center;vertical-align:middle;min-width:60px;max-width:80px;padding:4px 3px;">
                                    @Html.DisplayFor(modelItem => item.profil.ProfilKodu)
                                </td>
                                <td style="text-align:center;vertical-align:middle;">
                                    @Html.Raw("<img class='img-responsive img-thumbnailProf' src = '" + Url.Content("~/images/profilicons/" + item.profil.ProfilFoto) + "' />")
                                </td>
                                <td style="text-align:center;vertical-align:middle;">
                                    @Html.DisplayFor(modelItem => item.profil.ProfilAdi)
                                </td>
                                <td style="text-align:center;vertical-align:middle;">
                                    @if (item.profil.BirimAgirlik > 0)
                                    {
                                        @Html.DisplayFor(modelItem => item.profil.BirimAgirlik)
                                    }
                                    else
                                    {
                                        @Html.Raw("-")
                                    }
                                </td>
                                <td style="text-align:center;vertical-align:middle;">
                                    @Html.DisplayFor(modelItem => item.KullanilacakOlcu)
                                </td>
                                <td style="text-align:center;vertical-align:middle;"></td>
                                <td style="text-align:center;vertical-align:middle;word-wrap:break-word;min-width:120px;max-width:200px;">
                                    @FormatKesimOlculeri(item.KesileceklerOlcusu)
                                </td>
                                <td style="text-align:center;vertical-align:middle;">
                                    @Html.DisplayFor(modelItem => item.Adet)
                                </td>
                                @{
                                    var limit = ViewBag.minimumFire;

                                    if (item.FireAtik > limit)
                                    {

                                        @Html.Raw("<th class='bg-light-green' style='text-align:center;vertical-align:middle;min-width:50px;max-width:70px;padding:4px 3px;'>")
                                    }
                                    else
                                    {
                                        @Html.Raw("<th class='bg-red' style='text-align:center;vertical-align:middle;min-width:50px;max-width:70px;padding:4px 3px;'>")
                                    }
                                    @Html.Raw(item.FireAtik)
                                    @Html.Raw("</th>")
                                }
                                @if (item.eksikAdet != 0)
                                {
                                    <td style="text-align:center;vertical-align:middle;border-top: 2px solid red; border-bottom: 2px solid red; border-left: 2px solid red; border-right: 2px solid red;"><b>@Html.DisplayFor(modelItem => item.eksikAdet)</b></td>
                                }
                                else
                                {
                                    <td style="text-align:center;vertical-align:middle;">@Html.DisplayFor(modelItem => item.eksikAdet)</td>
                                }
                                <td style="text-align:center;vertical-align:middle;">
                                    @Html.DisplayFor(modelItem => item.mevcutStokMiktari)
                                </td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <th colspan=2>Toplam Atık</th>
                            <th colspan=3>Fire Stoğa Eklenen Toplam</th>
                            <th colspan=3>Asıl Stoktan Kullanılan Toplam</th>
                            <th colspan=3>Fire Stoktan Kullanılan Toplam</th>
                        </tr>
                        <tr>
                            <th>Uzunluk (Metre)</th>
                            <th>Ağırlık (Kg)</th>
                            <th>Uzunluk (Metre)</th>
                            <th colspan=2>Ağırlık (Kg)</th>
                            <th>Uzunluk (Metre)</th>
                            <th colspan=2>Ağırlık (Kg)</th>
                            <th>Uzunluk (Metre)</th>
                            <th colspan=2>Ağırlık (Kg)</th>
                        </tr>
                        <tr>
                            <th>@Html.Raw(string.Format("{0:N2}", Model.toplamAtikUzunluk))</th>
                            <th>@Html.Raw(string.Format("{0:N2}", Model.toplamAtikAgirlik))</th>
                            <th>@Html.Raw(string.Format("{0:N2}", Model.fireStogaEklenenToplam))</th>
                            <th colspan=2>@Html.Raw(string.Format("{0:N2}", Model.fireStogaEklenenToplamAgirlik))</th>
                            <th>@Html.Raw(string.Format("{0:N2}", Model.kullanilanToplamUzunlukAsil))</th>
                            <th colspan=2>@Html.Raw(string.Format("{0:N2}", Model.kullanilanToplamAgirlikAsil))</th>
                            <th>@Html.Raw(string.Format("{0:N2}", Model.kullanilanToplamUzunlukFire))</th>
                            <th colspan=2>@Html.Raw(string.Format("{0:N2}", Model.kullanilanToplamAgirlikFire))</th>
                        </tr>
                    </tfoot>
                </table>

                @Html.Raw(ViewBag.SiparisAciklamasi)
            </div>
        </div>
    </div>
</div>


<div class="modal-footer">
    <button type="button" onclick="PrintElem('imalatyazdir')" class="btn bg-red waves-effect waves-light">
        <i class="material-icons">print</i>
        <span>YAZDIR</span>
    </button>
    <button type="button" class="btn bg-green waves-effect waves-light" onclick="imalatOnayla()">İMALATI ONAYLA</button>
    <button type="button" class="btn bg-black waves-effect waves-light" data-dismiss="modal">KAPAT</button>
</div>

@functions {
    static string FormatKesimOlculeri(string olcular)
    {
        if (string.IsNullOrWhiteSpace(olcular)) return "";
        var parts = olcular.Split(new char[] { ',' }, System.StringSplitOptions.RemoveEmptyEntries);
        var groups = parts
            .GroupBy(x => x.Trim())
            .OrderByDescending(g => g.Count())
            .ThenBy(g => g.Key)
            .Select(g => string.Format("{0}x{1}", g.Count(), g.Key));
        return string.Join(", ", groups);
    }
}
