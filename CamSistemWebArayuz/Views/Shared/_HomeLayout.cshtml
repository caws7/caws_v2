<!DOCTYPE html>

<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>@ViewBag.Title</title>
    <link rel="icon" href="~/images/favicon.ico" type="image/x-icon">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css?family=Roboto:400,700&subset=latin,cyrillic-ext" rel="stylesheet" type="text/css">
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet" type="text/css">
    <!-- Bootstrap Core Css -->
    <link href="~/plugins/bootstrap/css/bootstrap.css" rel="stylesheet">
    <!-- Waves Effect Css -->
    <link href="~/plugins/node-waves/waves.css" rel="stylesheet" />
    <!-- Animation Css -->
    <link href="~/plugins/animate-css/animate.css" rel="stylesheet" />
    <!-- Custom Css -->
    <link href="~/css/style.css" rel="stylesheet">
    <!-- Colorpicker Css -->
    <link href="~/plugins/bootstrap-colorpicker/css/bootstrap-colorpicker.css" rel="stylesheet" />
    <!-- Multi Select Css -->
    <link href="~/plugins/multi-select/css/multi-select.css" rel="stylesheet">
    <!-- Bootstrap Select Css -->
    <link href="~/plugins/bootstrap-select/css/bootstrap-select.css" rel="stylesheet" />
    <link href="~/plugins/jquery-datatable/skin/bootstrap/css/dataTables.bootstrap.css" rel="stylesheet">
    <link href="~/plugins/bootstrap-datepicker/css/bootstrap-datepicker.css" rel="stylesheet" />
    <!-- AdminBSB Themes. You can choose a theme from css/themes instead of get all themes -->
    <link href="~/css/themes/all-themes.css" rel="stylesheet" />

    <style>
        /* =========================================================
   USER INFO (Logo + isim/mail/rol) + SIDEBAR MENU SCROLL
   Footer (copyright) her zaman görünür, menu tekerlekle kayar
   ========================================================= */

        /* ===== SIDEBAR LAYOUT: 3 satır (user-info / menu / footer) ===== */
        aside#leftsidebar.sidebar {
            display: flex !important;
            flex-direction: column !important;
            height: 100vh !important;
            overflow: hidden !important; /* menu kendi içinde scroll olacak */
        }

            /* Üst kullanıcı alanı (sabit) */
            aside#leftsidebar.sidebar > .user-info {
                flex: 0 0 auto !important;
            }

            /* Menü (scroll burada) */
            aside#leftsidebar.sidebar > .menu {
                flex: 1 1 auto !important;
                min-height: 0 !important; /* flex + overflow için kritik */
                overflow-y: auto !important;
                overflow-x: hidden !important;
                height: auto !important;
            }

            /* Footer (her zaman görünür) */
            aside#leftsidebar.sidebar > .legal {
                flex: 0 0 auto !important;
                display: block !important;
                position: relative !important;
                background: #fff !important;
                border-top: 1px solid #eee;
                padding: 10px 15px !important;
                z-index: 1 !important;
            }

        /* SlimScroll eklentisi wrapper bıraktıysa ölçüleri bozmasın */
        .sidebar .slimScrollDiv {
            height: auto !important;
        }

        .sidebar .menu .list {
            height: auto !important;
        }

        /* ===== USER INFO: AdminBSB absolute/sabit yükseklik iptal ===== */
        .sidebar .user-info.user-info--white {
            background: #ffffff !important;
            border-bottom: 1px solid #eee;
            display: flex !important;
            flex-direction: column !important;
            align-items: stretch !important;
            gap: 6px;
            padding: 10px !important;
            height: auto !important;
            min-height: 160px !important;
            overflow: visible !important;
            position: relative !important; /* dropdown ikon için */
            box-sizing: border-box;
        }

            /* Logo alanı */
            .sidebar .user-info.user-info--white .image {
                width: 100%;
                height: 100px; /* logo yüksekliği */
                overflow: hidden;
                display: flex;
                align-items: center;
                justify-content: flex-start;
                padding: 0 !important;
                border-radius: 0 !important;
                box-sizing: border-box;
            }

                /* Logo */
                .sidebar .user-info.user-info--white .image img {
                    width: 100% !important;
                    height: 100% !important;
                    object-fit: contain; /* kırpma yok, tamamı görünsün */
                    object-position: left center;
                    display: block;
                    border-radius: 0 !important;
                }

            /* AdminBSB’nin info-container absolute düzenini kapat */
            .sidebar .user-info.user-info--white .info-container {
                position: static !important;
                width: 100% !important;
                height: auto !important;
                overflow: visible !important;
                padding: 0 !important;
                margin: 0 !important;
                box-sizing: border-box;
            }

                /* Metinler */
                .sidebar .user-info.user-info--white .info-container .name,
                .sidebar .user-info.user-info--white .info-container .email,
                .sidebar .user-info.user-info--white .info-container .role {
                    display: block !important;
                    white-space: normal !important;
                    word-break: break-word;
                    line-height: 16px;
                    color: #222 !important;
                }

                .sidebar .user-info.user-info--white .info-container .name {
                    font-weight: 600;
                }

                .sidebar .user-info.user-info--white .info-container .email,
                .sidebar .user-info.user-info--white .info-container .role {
                    opacity: .75;
                    font-size: 12px;
                    margin-top: 2px;
                }

            /* Dropdown ikon */
            .sidebar .user-info.user-info--white .btn-group.user-helper-dropdown {
                position: absolute !important;
                right: 6px !important;
                top: 6px !important;
            }
        /* Footer'ı sidebar'ın en altına sabitle */
        aside#leftsidebar.sidebar .legal {
            display: block !important;
            position: fixed !important;
            left: 0 !important;
            bottom: 0 !important;
            width: 300px !important; /* AdminBSB default sidebar width */
            background: #fff !important;
            border-top: 1px solid #eee !important;
            z-index: 9999 !important;
            padding: 10px 15px !important;
            height: 80px !important; /* footer yüksekliği */
            box-sizing: border-box;
        }

        /* Footer menünün üstünü kapatmasın diye menüye alttan pay bırak */
        aside#leftsidebar.sidebar .menu {
            padding-bottom: 80px !important; /* footer yüksekliği kadar */
        }
        /* Üst barı ince şerit yap */
        .navbar {
            min-height: 10px !important;
            height: 10px !important;
            box-shadow: none !important; /* gölgeyi kaldır, daha kibar */
        }

            /* İç boşlukları sıfırla ki kalınlaşmasın */
            .navbar .container-fluid,
            .navbar .navbar-header {
                min-height: 10px !important;
                height: 10px !important;
                padding: 0 !important;
            }

            .navbar .navbar-brand,
            .navbar .navbar-toggle,
            .navbar .bars {
                display: none !important; /* içindeki ikon/boşluklar kalınlık yapıyor */
            }

        /* İçeriğin navbar altında boşluk bırakmasını azalt */
        section.content {
            margin-top: 10px !important; /* navbar yüksekliği ile aynı */
        }
        /* Navbar yüksekliğin (ince şerit) */
        :root {
            --topbar-h: 10px;
        }
        /* sen 10px yapmıştın; 6 yaptıysan 6px yaz */

        /* Sol sidebar kırmızı şeride yaslansın */
        #leftsidebar.sidebar {
            top: var(--topbar-h) !important;
        }

        /* Ana içerik de aynı yerden başlasın */
        section.content {
            margin-top: var(--topbar-h) !important;
        }

        /* AdminBSB wrapper kullanıyorsa */
        .overlay-open .sidebar,
        .sidebar {
            top: var(--topbar-h) !important;
        }
            .sidebar .menu .list li.header {
                text-align: center !important;
                padding-left: 0 !important;
                padding-right: 0 !important;
            }
        /* Tüm sayfalarda üstteki gri başlık alanını (Sipariş Yönetimi vb.) kaldır */
        .block-header {
            display: none !important;
        }

        /* Block-header kalkınca içerik yukarı yaslansın */
        section.content {
            padding-top: 0 !important;
            margin-top: 0 !important;
        }

            section.content > .container-fluid {
                padding-top: 0 !important;
                margin-top: 0 !important;
            }

            /* İlk satırda kalan ekstra boşluk varsa */
            section.content .row.clearfix:first-child {
                margin-top: 0 !important;
            }
    </style>
</head>
<body class="theme-red">
