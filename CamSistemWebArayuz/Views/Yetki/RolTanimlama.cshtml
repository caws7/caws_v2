@model CamSistemDataLayer.Models.RolSayfaYetki

@{
    ViewBag.Title = "CamSistem - Yetki Yönetimi | Rol Tanımlama";
    Layout = "~/Views/Shared/_HomeLayout.cshtml";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/jstree/3.2.1/themes/default/style.min.css" />

<div class="row clearfix">
    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
        <div class="card">
            <div class="header">
                <h2>Rol Tanımlama</h2>
            </div>
            <div class="body">
                @using (Html.BeginForm("RolTanimlama", "Yetki", FormMethod.Post, new { id = "form_validation" }))
                {
                    <input type="hidden" name="selectedItems" id="selectedItems" />
                    @Html.ValidationSummary(true)
                    @Html.AntiForgeryToken()

                    <div class="row clearfix">
                        @if (ViewData["error"] != null)
                        {
                            <div class="alert alert-warning alert-dismissible" role="alert">
                                <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                                    <span aria-hidden="true">×</span>
                                </button>
                                Aynı isimde rol bulunmaktadır! Farklı bir isimde rol oluşturmanız gerekmektedir.
                            </div>
                        }

                        <div class="col-sm-12">
                            <p><b>Rol Adı</b></p>
                            <div class="form-group">
                                <div class="form-line">
                                    <input id="RolAdi" name="RolAdi" type="text" value="" class="form-control" autocomplete="off" required />
                                </div>
                            </div>
                        </div>

                        <div class="col-sm-12">
                            <p><b>Yetkiler</b></p>
                            <div id="jstree"></div>
                            <div id="treeError" class="alert alert-danger" style="display:none; margin-top:10px;"></div>
                        </div>
                    </div>

                    <button type="submit" class="btn bg-green waves-effect">KAYDET</button>
                    <button type="button" class="btn bg-black waves-effect waves-light"
                            onclick="location.href='@Url.Action("Index", "Yetki")'">
                        LİSTEYE GERİ DÖN
                    </button>
                }
            </div>
        </div>
    </div>
</div>

@section scripts {
    @* Layout'ta jstree.min.js YOKSA bu CDN gerekli. Varsa bile sorun olmasın diye kontrolle yüklemek daha iyi ama şimdilik net çözüm: *@
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jstree/3.2.1/jstree.min.js"></script>

    <script>
        (function ($) {
            $(function () {

                // Controller string JSON döndürüyor: "[{...},{...}]"
                // Null gelirse boş dizi kullan
                var treeData = @Html.Raw(ViewBag.SayfaYetkiTree ?? "[]");

                if (!$.fn.jstree) {
                    $('#treeError').text("jsTree yüklenemedi. jstree.min.js dosyası sayfaya gelmiyor.").show();
                    return;
                }

                if (!Array.isArray(treeData)) {
                    try { treeData = JSON.parse(treeData); } catch (e) { treeData = []; }
                }

                if (!treeData || treeData.length === 0) {
                    $('#treeError').text("Yetki listesi boş geliyor. (Sayfa/Yetki tabloları veya ViewBag.SayfaYetkiTree kontrol edilmeli)").show();
                }

                $('#jstree').jstree({
                    core: {
                        multiple: true,
                        check_callback: true,
                        themes: {
                            responsive: false,
                            variant: "large",
                            stripes: false,
                            dots: false
                        },
                        data: treeData
                    },
                    types: {
                        "default": { icon: "fa fa-folder icon-state-warning icon-lg" },
                        "file": { icon: "fa fa-file icon-state-warning icon-lg" }
                    },
                    plugins: ["wholerow", "checkbox", "types"]
                });

                $('#jstree').on('changed.jstree', function (e, data) {
                    var selectedItems = [];

                    for (var i = 0; i < data.selected.length; i++) {
                        var rawId = data.selected[i];
                        var id = rawId;

                        // id formatınız: "YetkiIdiSayfaId-YetkiIdiSayfaId"
                        // POST tarafı item.id.Split('i') bekliyor -> "yetkiId" + "i" + "sayfaId"
                        if (id.indexOf('-') !== -1) {
                            id = id.split("-")[1];
                        }

                        selectedItems.push({
                            text: data.instance.get_node(rawId).text,
                            id: id,
                            parent: data.node && data.node.parents ? data.node.parents[0] : null
                        });
                    }

                    $('#selectedItems').val(JSON.stringify(selectedItems));
                });

            });
        })(jQuery);
    </script>
}